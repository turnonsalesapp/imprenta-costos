// Sistema de costos y producción — Imprenta
// PostgreSQL (Neon / Supabase). Correr: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
  // Railway construye sobre Debian con OpenSSL 3. Sin esto, el despliegue
  // falla con "Prisma Client could not locate the Query Engine".
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── usuarios y acceso ───────────────────────────

enum Rol {
  ADMIN     // ve costos y márgenes, edita variables y papeles
  VENDEDOR  // cotiza y ve precios; no edita las variables del negocio
  TALLER    // solo ve órdenes de producción, sin precios ni costos
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  passwordHash String
  rol          Rol      @default(VENDEDOR)
  activo       Boolean  @default(true)
  /// Interpretar solicitud con IA para ESTE usuario: null = hereda del sistema,
  /// true = siempre activo, false = siempre apagado. Solo aplica a quien cotiza.
  interpretarIA Boolean?
  /// Permisos de cotización por usuario. ADMIN siempre puede todo (ignora estos).
  puedeCotizar  Boolean  @default(true)  // interruptor general para cotizar
  tiposCotizar  String[] @default([])    // tipos permitidos; vacío = todos
  puedeEliminar Boolean  @default(false) // puede eliminar cotizaciones en borrador
  /// Ver la estructura de costos (costo, margen y desglose), no solo el precio.
  /// Se define por usuario, independiente del rol. TALLER no ve precios igual.
  verEstructura Boolean  @default(true)
  creadoEn     DateTime @default(now()) @db.Timestamptz(3)

  cotizaciones Cotizacion[]
  ordenes      Orden[]
  sesiones     Sesion[]
}

model Sesion {
  id        String   @id @default(cuid())
  usuarioId String
  token     String   @unique
  expiraEn  DateTime @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// ──────────────────────────────── clientes ────────────────────────────────

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  rif       String?
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  notas     String?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @db.Timestamptz(3)

  trabajos     Trabajo[]
  cotizaciones Cotizacion[]

  @@index([nombre])
}

// ─────────────────────── catálogo: papeles y acabados ───────────────────────

model Papel {
  id      String  @id @default(cuid())
  clave   String  @unique  // "Litho Autoadhesivo-200", estable para el motor
  nombre  String
  hojas   Int                        // hojas por resma o paquete
  precio  Decimal @db.Decimal(12, 4) // precio USD de la resma completa
  medida  String                     // "66x96" | "68x96" | "70x100"
  categoria String @default("Papel") // categoría de material para el inventario
  activo  Boolean @default(true)

  // Inventario (en pliegos completos).
  stock    Decimal @db.Decimal(14, 2) @default(0)
  stockMin Decimal @db.Decimal(14, 2) @default(0) // avisa cuando el stock baja de aquí

  // Proveedor preferido para costear ESTE papel (Fase 3). Si es null, se usa el
  // proveedor global `predeterminado`. `precio` de arriba es el precio EFECTIVO
  // (copia del preferido) para que el motor de cálculo no cambie.
  proveedorPreferidoId String?

  trabajos    Trabajo[]
  movimientos MovimientoInventario[]
  proveedorPreferido Proveedor?             @relation(fields: [proveedorPreferidoId], references: [id], onDelete: SetNull)
  preciosProveedor   PrecioProveedorPapel[]
}

// ─────────────────────── proveedores y listas de precios (Fase 3) ───────────────────────

/// Proveedor de papel/material. Se pueden cargar varias listas de precios y
/// comparar; el `predeterminado` es el respaldo global cuando un papel no tiene
/// proveedor preferido propio.
model Proveedor {
  id             String   @id @default(cuid())
  nombre         String   @unique
  moneda         String   @default("USD")
  contacto       String?
  notas          String?
  predeterminado Boolean  @default(false)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @db.Timestamptz(3)

  precios          PrecioProveedorPapel[]
  papelesPreferido Papel[]
}

/// Precio de un papel según un proveedor. Una fila por (papel, proveedor): es el
/// precio VIGENTE de esa lista. Permite comparar costos entre proveedores.
model PrecioProveedorPapel {
  id           String   @id @default(cuid())
  papelId      String
  proveedorId  String
  precio       Decimal  @db.Decimal(12, 4) // en la unidad indicada
  unidad       String   @default("resma")  // "resma" | "hoja" | "millar"
  hojas        Int?                         // hojas por resma según este proveedor
  medida       String?
  vigenteDesde DateTime @default(now()) @db.Timestamptz(3)
  notas        String?

  papel     Papel     @relation(fields: [papelId], references: [id], onDelete: Cascade)
  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@unique([papelId, proveedorId])
  @@index([proveedorId])
}

enum TipoMovimiento {
  ENTRADA // compra que suma stock
  SALIDA  // consumo al terminar una orden
  AJUSTE  // corrección manual
}

/// Movimientos de inventario de papel, en pliegos completos (cantidad con signo).
model MovimientoInventario {
  id        String         @id @default(cuid())
  papelId   String
  tipo      TipoMovimiento
  cantidad  Decimal        @db.Decimal(14, 2) // + entra, - sale
  saldo     Decimal        @db.Decimal(14, 2) // stock resultante, para auditoría
  motivo    String?
  ordenId   String?
  usuarioId String?
  fecha     DateTime       @default(now()) @db.Timestamptz(3)

  papel Papel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@index([papelId])
  @@index([fecha])
}

model Acabado {
  id     String  @id @default(cuid())
  clave  String  @unique  // "impTiro", "troquel"...  la usa el motor de cálculo
  label  String
  costo  Decimal @db.Decimal(12, 4) // tarifa base, referida a 1/4 de pliego
  unidad String  // pliego | elemento | millar | trabajo
  escala String  // area | min | fija   (solo aplica a unidad "pliego")
  orden  Int     @default(0)
  activo Boolean @default(true)
  /// Módulo al que pertenece el acabado: "digital" u "offset" (costos distintos).
  modulo String  @default("digital")
  /// Acabados con el mismo grupo son excluyentes en la calculadora (ej. troquel).
  grupo  String?
}

/// Material de GRAN FORMATO (tercerizado). Costo base por m² del proveedor.
/// `modoCobro` es el valor por defecto (el vendedor puede cambiarlo en la
/// cotización): "mancha" cobra el área impresa; "ancho_rollo" cobra el ancho
/// completo del rollo × alto. `anchosRollo` = anchos disponibles en cm (coma).
model MaterialGF {
  id         String  @id @default(cuid())
  clave      String  @unique
  nombre     String
  categoria  String  @default("Banner")
  costoM2    Decimal @db.Decimal(12, 4) // costo USD por m² (a BCV, del catálogo)
  modoCobro  String  @default("mancha") // "mancha" | "ancho_rollo" | "etiqueta"
  anchosRollo String @default("")       // "105,137,152" en cm
  montaje    String  @default("")       // lámina de montaje "125x70" (modo etiqueta)
  tablaEtq   String  @default("")       // rendimiento "3x3:660,4x4:510,…" (modo etiqueta)
  activo     Boolean @default(true)
}

/// Productos terminados de GRAN FORMATO (pendones, roll up, arañas, estructuras).
/// Costo FIJO por unidad, del catálogo del proveedor tercerizado. No se calcula
/// por m²: es un precio armado (impresión + estructura/acabado) que se cobra por
/// pieza y pasa por la misma cola de precio que todo el sistema.
model ProductoGF {
  id        String  @id @default(cuid())
  clave     String  @unique
  nombre    String
  categoria String  @default("Pendón") // Pendón | Roll Up | Araña | Estructura
  medida    String  @default("")       // etiqueta de tamaño, ej. "60×90 cm"
  costoUnit Decimal @db.Decimal(12, 4)  // costo USD por unidad (a BCV, del catálogo)
  activo    Boolean @default(true)
}

/// Productos PERSONALIZADOS / Material POP (chapas, llaveros, bolígrafos, DTF,
/// sublimación, corte láser). Tercerizados. Dos modos de costo del proveedor:
///   escalas = precio por unidad según el volumen ("1:3.5,12:2.2,50:2.1,100:1.5")
///   lineal  = precio por metro lineal, ancho fijo (DTF UV), con mínimo en cm
model ProductoPop {
  id           String  @id @default(cuid())
  clave        String  @unique
  nombre       String
  categoria    String  @default("Chapa") // Chapa | Llavero | Bolígrafo | DTF | ...
  modo         String  @default("escalas") // "escalas" | "lineal"
  escalas      String  @default("")       // "1:3.5,12:2.2,50:2.1,100:1.5" (desde:precio)
  precioLineal Decimal @db.Decimal(12, 4) @default(0) // costo USD por metro lineal
  anchoCm      Int     @default(0)         // ancho fijo del material (modo lineal)
  minCm        Int     @default(0)         // largo mínimo facturable (modo lineal)
  unidad       String  @default("unidad")  // etiqueta: "unidad" | "docena"
  activo       Boolean @default(true)
}

/// Equipos con los que cuenta el taller (prensas offset, etc.). En offset, los
/// colores por pasada definen cuántas pasadas hace un trabajo de N colores:
/// una prensa de 4 colores imprime un 4/0 en una pasada; una de 1 color, en 4.
model Equipo {
  id            String  @id @default(cuid())
  clave         String  @unique
  nombre        String
  coloresPasada Int     @default(4)          // colores que imprime por pasada
  costoMillar   Decimal @db.Decimal(12, 4) @default(6)  // costo por millar de pliegos, por pasada
  costoArranque Decimal @db.Decimal(12, 4) @default(15) // arranque/montaje por cara
  activo        Boolean @default(true)
}

/// Variables del negocio. Fila única con id = "global".
model Config {
  id            String   @id @default("global")
  merma         Decimal  @db.Decimal(6, 2) @default(3)
  margen        Decimal  @db.Decimal(6, 2) @default(30)
  comision      Decimal  @db.Decimal(6, 2) @default(3)
  ml            Decimal  @db.Decimal(6, 2) @default(12)
  tasaBCV       Decimal  @db.Decimal(14, 4)
  binCompra     Decimal  @db.Decimal(14, 4)
  binVenta      Decimal  @db.Decimal(14, 4)
  pinza         Decimal  @db.Decimal(6, 2) @default(5)
  sep           Decimal  @db.Decimal(6, 2) @default(3)
  margenMin     Decimal  @db.Decimal(6, 2) @default(15) // avisa si el margen baja de aquí
  iva           Decimal  @db.Decimal(6, 2) @default(16) // % de IVA en la cotización al cliente
  /// Interruptor general del intérprete de solicitudes con IA (todo el sistema).
  interpretarIA Boolean  @default(false)
  /// Modelo de IA elegido para el intérprete (null = el de por defecto).
  interpretarModelo String?
  /// Gran formato: costo por ojete (lo que cobra Digital Print: $0,8 instalado,
  /// incluye refilado) y separación por defecto entre ojetes (cm).
  gfOjeteCosto  Decimal @db.Decimal(10, 4) @default(0.8)
  gfOjeteCm     Int     @default(40)
  /// Offset (producción propia): costos base, ajustables por cotización.
  offPlancha       Decimal @db.Decimal(12, 4) @default(4)   // plancha 1/4 de pliego
  offPlanchaMedio  Decimal @db.Decimal(12, 4) @default(7)   // plancha 1/2 pliego
  offPlanchaPliego Decimal @db.Decimal(12, 4) @default(12)  // plancha pliego completo
  offArranque   Decimal @db.Decimal(12, 4) @default(12)  // arranque/montaje por cara (makeready)
  offMillar     Decimal @db.Decimal(12, 4) @default(5)   // costo por millar de pliegos impresos (por pasada)
  offTinta      Decimal @db.Decimal(12, 4) @default(2)   // costo de tinta por millar de pliegos, por color
  // Membrete para la cotización que se envía al cliente.
  empresaNombre    String?
  empresaRif       String?
  empresaTelefono  String?
  empresaDireccion String?
  empresaEmail     String?
  empresaWeb       String?
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)
}

/// Histórico de tasas, para saber con qué cambio se cotizó cada trabajo.
model Tasa {
  id        String   @id @default(cuid())
  fecha     DateTime @default(now()) @db.Timestamptz(3)
  bcv       Decimal  @db.Decimal(14, 4)
  binCompra Decimal  @db.Decimal(14, 4)
  binVenta  Decimal  @db.Decimal(14, 4)

  @@index([fecha])
}

// ───────────────────── trabajos repetidos (plantillas) ─────────────────────

/// Un trabajo que el cliente vuelve a pedir: guarda la receta, no el precio.
/// Recotizar = cargar el trabajo + tasas de hoy y volver a calcular.
model Trabajo {
  id          String   @id @default(cuid())
  clienteId   String?
  nombre      String
  descripcion String?
  ancho       Int      // mm
  alto        Int      // mm
  tamano      String   // "1/4 Pliego"...
  papelId     String?
  capacidad   Int      // piezas por corte
  capAuto     Boolean  @default(true)
  acabados    Json     // { "impTiro": { "on": true, "q": 1 }, ... }
  archivado   Boolean  @default(false)
  creadoEn    DateTime @default(now()) @db.Timestamptz(3)

  cliente      Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  papel        Papel?       @relation(fields: [papelId], references: [id], onDelete: SetNull)
  cotizaciones Cotizacion[]

  @@index([clienteId])
}

// ──────────────────────────────── cotización ────────────────────────────────

enum EstadoCotizacion {
  BORRADOR    // "Cotización": borrador en elaboración
  PENDIENTE   // pendiente de aprobación interna
  APROBADA    // aprobada internamente, lista para enviar al cliente
  ENVIADA     // enviada al cliente
  GANADA      // el cliente aceptó → dispara la Orden de Producción
  RECHAZADA   // "Perdida"
  VENCIDA
}

enum TipoCotizacion {
  PROPIA       // producción propia (papel + acabados, motor completo)
  PROVEEDOR    // trabajo tercerizado: se parte del costo que da el proveedor
  GRAN_FORMATO // impresión de gran formato tercerizada (costo por m² del material)
  PERSONALIZADO // material POP tercerizado: chapas, llaveros, DTF, sublimación, láser
  OFFSET       // impresión offset de producción propia (planchas + arranque + millar)
  MIXTA        // cotización con ítems de varios tipos a la vez
}

/// Una cotización es inmutable: guarda copia de TODO lo que se usó para
/// calcularla (papeles, acabados, tasas). Si mañana sube el papel, la
/// cotización de ayer sigue mostrando lo que se le prometió al cliente.
model Cotizacion {
  id        String           @id @default(cuid())
  numero    Int              @unique @default(autoincrement())
  estado    EstadoCotizacion @default(BORRADOR)
  tipo      TipoCotizacion   @default(PROPIA)
  clienteId String?
  // Datos del proveedor cuando el trabajo es tercerizado (tipo = PROVEEDOR).
  proveedorNombre String?
  proveedorRef    String?
  proveedorNotas  String?
  /// Nombre de cliente en texto libre (Fase 3). En la Fase 4, con el CRUD de
  /// clientes, se enlaza `clienteId` y este queda como respaldo de lo escrito.
  clienteNombre String?
  trabajoId String?
  usuarioId String?

  titulo      String
  descripcion String?
  cantidad    Int
  ancho       Int
  alto        Int
  tamano      String
  papelNombre String
  capacidad   Int

  entrada   Json // Entrada exacta que recibió el motor (del primer ítem; compat)
  snapshot  Json // { papeles, acabados, config } del momento del cálculo (compartido)
  lineas    Json // desglose línea por línea (unión, para generar la orden)
  /// Ítems de la cotización (array congelado). Una cotización puede tener varios
  /// ítems (p. ej. el mismo trabajo a distintos volúmenes). Null en las viejas:
  /// se sintetiza un ítem único desde las columnas de arriba al leerlas.
  items     Json?

  pliegos    Decimal @db.Decimal(14, 4)
  costoTotal Decimal @db.Decimal(14, 4)
  costoUnit  Decimal @db.Decimal(14, 6)
  diferencial Decimal @db.Decimal(10, 6)
  margen     Decimal @db.Decimal(6, 2)
  precioUnit Decimal @db.Decimal(14, 6)
  ventaTotal Decimal @db.Decimal(14, 4)
  precioML   Decimal @db.Decimal(14, 6)
  tasaBCV    Decimal @db.Decimal(14, 4)
  precioBs   Decimal @db.Decimal(16, 4)

  validaHasta DateTime? @db.Timestamptz(3)
  notas       String?
  /// Referencia a la cotización en el sistema PARALELO/externo (número o código).
  /// Relaciona este registro con la cotización hecha por fuera del sistema.
  refCotizacion String?
  creadaEn    DateTime @default(now()) @db.Timestamptz(3)

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  trabajo Trabajo? @relation(fields: [trabajoId], references: [id], onDelete: SetNull)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  orden   Orden?

  // Hilo del trabajo (comentarios + adjuntos). Se ancla a la COTIZACIÓN; la orden
  // muestra el mismo hilo vía su cotizacionId. NO contiene dinero: por diseño es
  // seguro para el rol TALLER (participa por la orden sin ver precios).
  comentarios Comentario[]
  adjuntos    Adjunto[]

  @@index([clienteId])
  @@index([estado])
  @@index([creadaEn])
}

// ─────────────────── hilo del trabajo: comentarios + adjuntos ───────────────────

/// Comentario en el hilo de un trabajo. Se ancla a UNA cotización (lo comparten
/// la cotización y su orden) o a UNA oportunidad/prospecto (solo ADMIN/VENDEDOR).
/// Siempre exactamente uno de los dos ids (XOR, validado en la app). SIN precios.
model Comentario {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  cotizacionId String?
  prospectoId  String?
  autorId      String? // usuario que lo escribió (null si se borra el usuario)
  autorNombre  String // nombre congelado, para que sobreviva
  texto        String
  creadoEn     DateTime @default(now()) @db.Timestamptz(3)

  cotizacion Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  prospecto  Prospecto?  @relation(fields: [prospectoId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
  @@index([prospectoId])
}

/// Adjunto del hilo de un trabajo (artes, referencias, pruebas). Se ancla a UNA
/// cotización o a UNA oportunidad/prospecto (XOR, validado en la app). Almacén
/// "db" guarda los bytes en `datos`, "drive" referencia el archivo remoto. NO
/// contiene dinero: seguro para el rol TALLER (solo llega por la orden).
model Adjunto {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  cotizacionId String?
  prospectoId  String?
  autorId      String?
  autorNombre  String
  nombre       String
  tipo         String // mime type
  tamano       Int // bytes
  almacen      String   @default("db") // "db" | "drive"
  datos        Bytes? // bytea cuando almacen = "db"
  driveFileId  String?
  url          String?
  creadoEn     DateTime @default(now()) @db.Timestamptz(3)

  cotizacion Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  prospecto  Prospecto?  @relation(fields: [prospectoId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
  @@index([prospectoId])
}

// ─────────────────────────── orden de producción ───────────────────────────

enum EstadoOrden {
  PENDIENTE
  EN_PROCESO
  TERMINADA
  ENTREGADA
  ANULADA
}

/// Se genera desde una cotización aprobada. Es el papel que va al taller:
/// lleva la receta y las etapas, NO lleva precios ni márgenes.
model Orden {
  id           String      @id @default(cuid())
  numero       Int         @unique @default(autoincrement())
  cotizacionId String      @unique
  estado       EstadoOrden @default(PENDIENTE)
  usuarioId    String?

  fechaEntrega DateTime? @db.Timestamptz(3)
  prioridad    Int      @default(0)
  instrucciones String?
  /// Proyección SIN precios de los ítems de la cotización, para la hoja del
  /// taller. Se construye al generar la orden (contexto ADMIN/VENDEDOR) y por
  /// diseño NUNCA contiene dinero: así el taller ve el detalle por ítem sin que
  /// una columna de precio pueda filtrarse por aquí.
  items        Json?
  inventarioAplicado Boolean @default(false) // si ya descontó el papel al terminar
  // Seguimiento de cobro (NO es factura fiscal): NO_FACTURADO → FACTURADO → COBRADO.
  estadoCobro  EstadoCobro @default(NO_FACTURADO)
  fechaFactura DateTime? @db.Timestamptz(3)
  fechaCobro   DateTime? @db.Timestamptz(3)
  creadaEn     DateTime @default(now()) @db.Timestamptz(3)
  cerradaEn    DateTime? @db.Timestamptz(3)

  cotizacion Cotizacion   @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  usuario    Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  etapas     EtapaOrden[]
  piezas     PiezaOrden[]

  @@index([estado])
  @@index([fechaEntrega])
}

enum EstadoEtapa {
  PENDIENTE
  EN_PROCESO
  LISTA
  OMITIDA
}

/// Cada acabado de la cotización se convierte en una etapa del taller.
model EtapaOrden {
  id          String      @id @default(cuid())
  ordenId     String
  clave       String      // misma clave del acabado: "impTiro", "troquelado"...
  nombre      String
  orden       Int         @default(0)
  estado      EstadoEtapa @default(PENDIENTE)
  responsable String?
  iniciadaEn  DateTime? @db.Timestamptz(3)
  terminadaEn DateTime? @db.Timestamptz(3)
  notas       String?
  piezaId     String?   // etapa de una pieza concreta (Fase 2: producción por pieza)

  ordenProd Orden       @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  pieza     PiezaOrden? @relation(fields: [piezaId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@index([piezaId])
}

// ─────────────────────── producción por pieza (Fase 2) ───────────────────────

/// Carril de una pieza: producción interna (taller) o tercerizada (compras).
enum CarrilPieza {
  INTERNO     // PROPIA / OFFSET → taller: diseño, impresión, acabado
  TERCERIZADO // GRAN_FORMATO / PROVEEDOR / PERSONALIZADO → compra al proveedor
}

/// Estado de una pieza dentro de su carril. El tablero de producción muestra
/// las columnas que aplican a cada carril.
enum EstadoPieza {
  // Carril INTERNO (taller)
  EN_COLA        // en cola de diseño
  EN_DISENO
  ESPERANDO_ARTE // esperando artes del cliente
  EN_IMPRESION
  EN_ACABADO
  LISTA          // terminada en taller
  // Carril TERCERIZADO (compras al proveedor)
  POR_COTIZAR
  COMPRADO
  RECIBIDO
  ENTREGADO
}

/// Seguimiento de cobro de la orden. Solo estado (no factura fiscal).
enum EstadoCobro {
  NO_FACTURADO
  FACTURADO
  COBRADO
}

/// Una PIEZA de una orden: cada ítem de la cotización (interno o tercerizado) se
/// sigue por separado con su propio estado. El snapshot NO lleva precios (es lo
/// que ve el taller). Las etapas de acabado cuelgan de la pieza interna.
model PiezaOrden {
  id              String      @id @default(cuid())
  ordenId         String
  carril          CarrilPieza
  tipo            String      // TipoCotizacion del ítem (PROPIA/OFFSET/GRAN_FORMATO/...)
  titulo          String
  cantidad        Int         @default(0)
  estado          EstadoPieza
  orden           Int         @default(0)
  proveedorNombre String?     // proveedor de la pieza tercerizada
  snapshot        Json?       // ItemProd sin precios, para la hoja del taller
  notas           String?
  creadaEn        DateTime    @default(now()) @db.Timestamptz(3)
  actualizadaEn   DateTime    @updatedAt @db.Timestamptz(3)

  ordenProd Orden        @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  etapas    EtapaOrden[]

  @@index([ordenId])
  @@index([estado])
}

// ─────────────────────────── auditoría ───────────────────────────

/// Bitácora de operaciones sensibles (cambios de estado de cotización, de rol,
/// activación/desactivación de usuarios). Registra actor, acción y momento.
/// No se borra ni edita; es solo-agregar.
model RegistroAuditoria {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now()) @db.Timestamptz(3)
  actorId     String?  // usuario que hizo la acción (puede quedar null si se borra)
  actorNombre String?  // nombre congelado, para que el registro sobreviva
  accion      String   // "cotizacion.estado", "usuario.rol", "usuario.activo"...
  entidad     String?  // id o número del objeto afectado
  detalle     String?  // texto legible del cambio

  @@index([fecha])
}

// ─────────────────────────── CRM comercial ───────────────────────────

/// Estado de un prospecto/oportunidad ANTES de convertirse en cotización.
/// Reemplaza la columna "Clientes" del tablero comercial de Trello.
enum ProspectoEstado {
  NUEVO       // recién capturado
  CONTACTADO  // ya se le habló
  CONVERTIDO  // se volvió cotización
  DESCARTADO  // no prosperó
}

/// Oportunidad comercial previa a cotizar. Se enlaza por id (sin FK dura) al
/// cliente y, al convertirse, a la cotización creada.
model Prospecto {
  id            String          @id @default(cuid())
  nombre        String          // qué quiere / nombre de la oportunidad
  clienteNombre String?         // cliente (texto libre o copia del nombre)
  clienteId     String?         // id del Cliente si ya existe
  contacto      String?         // teléfono/correo de contacto
  detalle       String?
  estado        ProspectoEstado @default(NUEVO)
  cotizacionId  String?         // cotización creada al convertir
  usuarioId     String?         // quién lo capturó
  creadoEn      DateTime        @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime        @updatedAt @db.Timestamptz(3)

  // Hilo de la oportunidad (comentarios + adjuntos), como el de la cotización.
  // Solo lo ven ADMIN/VENDEDOR. Se borra en cascada al eliminar el prospecto.
  comentarios Comentario[]
  adjuntos    Adjunto[]

  @@index([estado])
}

/// Tipo de gestión comercial agendada. Reemplaza "Agendar Reunión" de Trello.
enum ActividadTipo {
  REUNION
  LLAMADA
  SEGUIMIENTO
  NOTA
}

/// Actividad/recordatorio comercial (reunión, llamada, seguimiento). Se enlaza
/// por id (sin FK dura) a cliente, prospecto o cotización, lo que aplique.
model Actividad {
  id            String        @id @default(cuid())
  tipo          ActividadTipo @default(REUNION)
  titulo        String
  fecha         DateTime?     @db.Timestamptz(3) // cuándo está agendada
  hecha         Boolean       @default(false)
  notas         String?
  clienteId     String?
  clienteNombre String?
  prospectoId   String?
  cotizacionId  String?
  usuarioId     String?
  creadoEn      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([hecha, fecha])
}
